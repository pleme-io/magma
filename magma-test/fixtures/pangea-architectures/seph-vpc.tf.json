{
  "terraform": {
    "required_providers": {
      "aws": { "source": "hashicorp/aws", "version": "~> 5.0" }
    }
  },
  "provider": { "aws": { "region": "us-east-1" } },
  "resource": {
    "aws_vpc": {
      "main": {
        "cidr_block":           "10.50.0.0/16",
        "enable_dns_support":   true,
        "enable_dns_hostnames": true,
        "tags": { "ManagedBy": "pangea", "Workspace": "seph-vpc" }
      }
    },
    "aws_internet_gateway": {
      "main": {
        "vpc_id": "${aws_vpc.main.id}",
        "tags":   { "ManagedBy": "pangea" }
      }
    },
    "aws_subnet": {
      "public_a":  { "vpc_id": "${aws_vpc.main.id}", "cidr_block": "10.50.1.0/24" },
      "private_a": { "vpc_id": "${aws_vpc.main.id}", "cidr_block": "10.50.2.0/24" }
    },
    "aws_route_table": {
      "public": {
        "vpc_id": "${aws_vpc.main.id}",
        "route":  [{ "cidr_block": "0.0.0.0/0", "gateway_id": "${aws_internet_gateway.main.id}" }]
      }
    },
    "aws_route_table_association": {
      "public_a": { "subnet_id": "${aws_subnet.public_a.id}", "route_table_id": "${aws_route_table.public.id}" }
    }
  },
  "output": {
    "vpc_id":      { "value": "${aws_vpc.main.id}",      "sensitive": false },
    "subnet_a_id": { "value": "${aws_subnet.public_a.id}", "sensitive": false }
  }
}
