{
  "terraform": {
    "required_providers": {
      "aws":      { "source": "hashicorp/aws",                "version": "~> 5.0" },
      "akeyless": { "source": "akeyless-community/akeyless",  "version": "~> 1.0" }
    }
  },
  "provider": { "aws": { "region": "us-east-1" } },
  "resource": {
    "aws_security_group": {
      "k3s": {
        "name":   "akeyless-dev-k3s",
        "vpc_id": "${data.aws_vpc.main.id}",
        "tags":   { "ManagedBy": "pangea", "Cluster": "akeyless-dev" }
      }
    },
    "aws_security_group_rule": {
      "k3s_api_ingress": {
        "type":              "ingress",
        "from_port":         6443,
        "to_port":           6443,
        "protocol":          "tcp",
        "cidr_blocks":       ["10.0.0.0/16"],
        "security_group_id": "${aws_security_group.k3s.id}"
      },
      "k3s_egress_all": {
        "type":              "egress",
        "from_port":         0,
        "to_port":           0,
        "protocol":          "-1",
        "cidr_blocks":       ["0.0.0.0/0"],
        "security_group_id": "${aws_security_group.k3s.id}"
      }
    },
    "aws_instance": {
      "control_plane": {
        "ami":           "ami-0c2b0d3fb02824d92",
        "instance_type": "t3.medium",
        "vpc_security_group_ids": ["${aws_security_group.k3s.id}"],
        "tags": { "ManagedBy": "pangea", "Role": "control-plane" }
      }
    },
    "akeyless_dynamic_secret": {
      "aws_dev": {
        "name":    "/akeyless/dynamic/aws-dev",
        "gateway_url": "https://gateway.example.com:8000"
      }
    }
  },
  "data": {
    "aws_vpc": { "main": { "default": true } }
  }
}
