{
  "terraform": {
    "required_providers": {
      "aws": { "source": "hashicorp/aws", "version": "~> 5.0" }
    }
  },
  "provider": { "aws": { "region": "us-east-1" } },
  "resource": {
    "aws_lb": {
      "ingress": {
        "name":                       "platform-ingress-alb",
        "load_balancer_type":         "application",
        "internal":                   false,
        "security_groups":            ["sg-alb-123"],
        "subnets":                    ["subnet-a", "subnet-b"],
        "enable_deletion_protection": false,
        "drop_invalid_header_fields": true
      }
    },
    "aws_lb_listener": {
      "https": {
        "load_balancer_arn": "${aws_lb.ingress.arn}",
        "port":              443,
        "protocol":          "HTTPS",
        "ssl_policy":        "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "certificate_arn":   "arn:aws:acm:us-east-1:123:certificate/xxx",
        "default_action":    { "type": "forward", "target_group_arn": "${aws_lb_target_group.app.arn}" }
      },
      "http_redirect": {
        "load_balancer_arn": "${aws_lb.ingress.arn}",
        "port":              80,
        "protocol":          "HTTP",
        "default_action":    { "type": "redirect", "redirect": { "port": "443", "protocol": "HTTPS", "status_code": "HTTP_301" } }
      }
    },
    "aws_lb_target_group": {
      "app": {
        "name":     "platform-ingress-app",
        "port":     8080,
        "protocol": "HTTP",
        "vpc_id":   "vpc-x",
        "health_check": { "path": "/healthz", "matcher": "200" }
      }
    },
    "aws_wafv2_web_acl": {
      "ingress": {
        "name":  "platform-ingress-waf",
        "scope": "REGIONAL",
        "default_action": { "block": {} }
      }
    }
  }
}
