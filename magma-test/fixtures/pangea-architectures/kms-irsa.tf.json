{
  "terraform": {
    "required_providers": {
      "aws": { "source": "hashicorp/aws", "version": "~> 5.0" }
    }
  },
  "provider": { "aws": { "region": "us-east-1" } },
  "resource": {
    "aws_kms_key": {
      "etcd_encryption": {
        "description":             "etcd CMK for K3s",
        "deletion_window_in_days": 30,
        "enable_key_rotation":     true,
        "tags":                    { "ManagedBy": "pangea", "Purpose": "etcd-encryption" }
      },
      "ebs_root": {
        "description":             "EBS root volume CMK",
        "deletion_window_in_days": 30,
        "enable_key_rotation":     true
      }
    },
    "aws_kms_alias": {
      "etcd": {
        "name":          "alias/etcd-encryption",
        "target_key_id": "${aws_kms_key.etcd_encryption.id}"
      },
      "ebs": {
        "name":          "alias/ebs-root",
        "target_key_id": "${aws_kms_key.ebs_root.id}"
      }
    },
    "aws_iam_role": {
      "cilium_irsa": {
        "name": "cilium-irsa",
        "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Federated\":\"arn:aws:iam::123:oidc-provider/oidc.eks.us-east-1.amazonaws.com\"},\"Action\":\"sts:AssumeRoleWithWebIdentity\"}]}"
      }
    },
    "aws_iam_policy": {
      "cilium_eni": {
        "name":   "cilium-eni-policy",
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":[\"ec2:CreateNetworkInterface\",\"ec2:AttachNetworkInterface\",\"ec2:DetachNetworkInterface\"],\"Resource\":\"*\"}]}"
      }
    },
    "aws_iam_role_policy_attachment": {
      "cilium": {
        "role":       "${aws_iam_role.cilium_irsa.name}",
        "policy_arn": "${aws_iam_policy.cilium_eni.arn}"
      }
    }
  }
}
