{
  "terraform": {
    "required_providers": {
      "aws": { "source": "hashicorp/aws", "version": "~> 5.0" }
    }
  },
  "provider": { "aws": { "region": "us-east-1" } },
  "resource": {
    "aws_route53_zone": {
      "akeyless_dev": {
        "name":    "dev.akeyless.io",
        "comment": "Akeyless development zone — managed by Pangea"
      }
    },
    "aws_acm_certificate": {
      "akeyless_dev_wildcard": {
        "domain_name":               "*.dev.akeyless.io",
        "validation_method":         "DNS",
        "subject_alternative_names": ["dev.akeyless.io"],
        "tags": { "ManagedBy": "pangea", "Account": "akeyless-dev" }
      }
    },
    "aws_acm_certificate_validation": {
      "akeyless_dev_wildcard": {
        "certificate_arn":         "${aws_acm_certificate.akeyless_dev_wildcard.arn}",
        "validation_record_fqdns": ["_validation.dev.akeyless.io"]
      }
    },
    "aws_route53_record": {
      "akeyless_dev_validation": {
        "zone_id": "${aws_route53_zone.akeyless_dev.id}",
        "name":    "_validation.dev.akeyless.io",
        "type":    "CNAME",
        "ttl":     60,
        "records": ["pending.validation.aws"]
      }
    }
  },
  "output": {
    "akeyless_dev_zone_id":      { "value": "${aws_route53_zone.akeyless_dev.id}",        "sensitive": false },
    "akeyless_dev_zone_name":    { "value": "${aws_route53_zone.akeyless_dev.name}",      "sensitive": false },
    "akeyless_dev_cert_arn":     { "value": "${aws_acm_certificate.akeyless_dev_wildcard.arn}", "sensitive": false }
  }
}
